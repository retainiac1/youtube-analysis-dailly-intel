# Secrets — never commit
.env
.env.*
# ...but the non-secret template IS tracked, so the required keys are discoverable.
!.env.example

# SQLite database + WAL/SHM sidecars
data/database/swipefile.db
data/database/swipefile.db-wal
data/database/swipefile.db-shm

# Any SQLite DB under data/database (live, backups, repro/smoke copies) and a stray
# root copy — DB binaries are never committed.
data/database/*.db
/swipefile.db

# Database backups
data/database/backups/

# Pipeline resume state
state.json

# Dashboard server log (traceback record; never committed)
logs/

# Python / virtualenv
.venv/
__pycache__/
*.pyc

# Editor / OS
.idea/
.DS_Store
