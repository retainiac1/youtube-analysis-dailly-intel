# API keys for the daily-intel pipeline and interpretation generator.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# YouTube Data API v3 key (pipeline).
YOUTUBE_API_KEY=your-youtube-data-api-key

# LLM provider keys (interpretation generator). Each is required only for the
# provider you actually run; a missing key fails that provider with a clear,
# provider-named error.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
XAI_API_KEY=xai-...
GEMINI_API_KEY=your-gemini-api-key
